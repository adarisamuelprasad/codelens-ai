# Shared with codelens-api (CODELENS_AI_KEY there). Unset = every /v1 call refuses with 503.
CODELENS_SHARED_KEY=

# gemini | groq | none. "none" (or a missing key) makes /v1/explain answer 503,
# and codelens-api stores findings with the rule's own message only.
LLM_PROVIDER=none
GOOGLE_API_KEY=
GROQ_API_KEY=
# Optional overrides. Defaults: gemini-2.5-flash, llama-3.3-70b-versatile.
LLM_MODEL=
LLM_TIMEOUT_SECONDS=20
LLM_TEMPERATURE=0.2
